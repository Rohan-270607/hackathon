# Reference only: the app reads real environment variables and never loads this file.
# Set these in your shell or a secrets manager. Never commit real values.

# Credentials (resolved by the Anthropic SDK; alternatively run `ant auth login`)
ANTHROPIC_API_KEY=

# Model and request options
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high            # low | medium | high | xhigh | max; empty = omit
AGENT_FALLBACKS=default      # server-side refusal fallback; empty = off
AGENT_MAX_TOKENS=16000

# Local models (AGENT_PROVIDER=ollama, AGENT_MODEL=<name from `ollama list`>)
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
OLLAMA_TIMEOUT=600

# Limits
AGENT_MAX_STEPS=25
AGENT_MAX_TOOL_CALLS=60
AGENT_TOOL_TIMEOUT=30
AGENT_TOOL_OUTPUT_CHARS=12000

# Paths
AGENT_DATA_DIR=data
AGENT_WORKSPACE=workspace

# Approval policy per tool risk: allow | ask | deny
AGENT_POLICY_READ=allow
AGENT_POLICY_WRITE=allow
AGENT_POLICY_EXEC=ask
AGENT_POLICY_NETWORK=ask
